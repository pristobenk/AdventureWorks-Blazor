@page "/orders/preview/{OrderId:int}"

@using AdventureWorks.Web.Models
@using Gotho.BlazorPdf
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ILogger<PreviewInvoice> Logger

<FluentLayout Style="height:100%; display:flex; flex-direction:column;">
    <FluentToolbar class="toolbar-fixed">
        <h3>Invoice Preview - Order #@OrderId</h3>
        <div style="margin-left:auto; display:flex; gap:8px; align-items:center;">
            <FluentButton Appearance="Appearance.Neutral" @onclick="Back">Back</FluentButton>
            <FluentButton Appearance="Appearance.Neutral" Disabled="@(string.IsNullOrWhiteSpace(pdfUrl))" @onclick="OpenInNewTab">Open in new tab</FluentButton>
            <FluentButton Appearance="Appearance.Accent" Disabled="@(string.IsNullOrWhiteSpace(pdfUrl))" @onclick="DownloadPdf">Download</FluentButton>
        </div>
    </FluentToolbar>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <FluentMessageBar Intent="@messageIntent" Style="margin:8px 16px;">
            @message
        </FluentMessageBar>
    }

    <div style="padding:12px; flex:1; min-height:0; display:flex; flex-direction:column;">
        @if (isLoading)
        {
            <div style="display:flex; align-items:center; justify-content:center; height:100%;">
                <FluentProgress />
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(pdfUrl))
        {
            <div style="flex:1; min-height:0; display:flex;">
                <div style="width:100%; height:100%;">
                    <PdfViewer Url="@pdfUrl" />
                </div>
            </div>
        }
        else
        {
            <div style="display:flex; align-items:center; justify-content:center; height:100%; color:var(--neutral-foreground-hint);">
                No preview available.
            </div>
        }
    </div>
</FluentLayout>

@code {
    [Parameter]
    public int OrderId { get; set; }

    private string? pdfUrl;
    private bool isLoading = true;
    private string? message;
    private MessageIntent messageIntent = MessageIntent.Info;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User?.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        await LoadPdfAsync();
    }

    private async Task LoadPdfAsync()
    {
        isLoading = true;
        message = null;

        try
        {
            var url = $"https://localhost:60241/orders/{OrderId}/invoice/pdf";
            var request = new HttpRequestMessage(HttpMethod.Get, url);
            var response = await Http.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);

            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login", true);
                return;
            }

            response.EnsureSuccessStatusCode();

            var bytes = await response.Content.ReadAsByteArrayAsync();
            var base64 = Convert.ToBase64String(bytes);

            pdfUrl = await JS.InvokeAsync<string>("createObjectUrlFromBase64", base64, "application/pdf");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load invoice {OrderId}", OrderId);
            message = "Failed to load invoice preview.";
            messageIntent = MessageIntent.Error;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/orders");
    }

    private void OpenInNewTab()
    {
        if (string.IsNullOrWhiteSpace(pdfUrl)) return;
        // open object url in new tab
        Navigation.NavigateTo(pdfUrl, true);
    }

    private async Task DownloadPdf()
    {
        if (string.IsNullOrWhiteSpace(pdfUrl)) return;

        try
        {
            // fetch object url as blob via JS and trigger download
            var bytes = await Http.GetByteArrayAsync($"https://localhost:60241/orders/{OrderId}/invoice/pdf");
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFileFromBase64", base64, $"invoice-{OrderId}.pdf", "application/pdf");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to download invoice {OrderId}", OrderId);
            message = "Failed to download invoice.";
            messageIntent = MessageIntent.Error;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!string.IsNullOrWhiteSpace(pdfUrl))
        {
            await JS.InvokeVoidAsync("revokeObjectUrl", pdfUrl);
        }
    }
}
