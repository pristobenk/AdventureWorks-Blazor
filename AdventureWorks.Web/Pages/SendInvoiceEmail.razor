@page "/orders/email/{OrderId:int}"

@using AdventureWorks.Web.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<SendInvoiceEmail> Logger

<FluentLayout Style="height:100%; display:flex; flex-direction:column;">
    <FluentToolbar class="toolbar-fixed">
        <h3>Send Invoice Email - Order #@OrderId</h3>
        <div style="margin-left:auto; display:flex; gap:8px; align-items:center;">
            <FluentButton Appearance="Appearance.Neutral" @onclick="Back">Back</FluentButton>
            <FluentButton Appearance="Appearance.Neutral" @onclick="RegenerateTemplate" Disabled="@(order is null || customer is null)">Use Template</FluentButton>
            <FluentButton Appearance="Appearance.Accent" Disabled="@(!CanSend)" @onclick="SendEmailAsync">
                @if (isSending)
                {
                    <FluentProgress />
                }
                else
                {
                    <span>Send Email</span>
                }
            </FluentButton>
        </div>
    </FluentToolbar>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <FluentMessageBar Intent="@messageIntent" Style="margin-bottom:8px;">
            @message
        </FluentMessageBar>
    }

    <div style="display:flex; flex-direction:column; gap:12px; flex:1; min-height:0; padding-bottom:12px;">
      

        <FluentCard Style="padding:16px; height:30%; min-height:0; overflow:auto;">
            <EditForm Model="formModel" OnValidSubmit="SendEmailAsync">
                <DataAnnotationsValidator />
                <FluentValidationSummary />

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                        <FluentLabel Typo="Typography.Body" Style="min-width:160px; color: var(--neutral-foreground-hint);">To Email</FluentLabel>
                        <FluentTextField @bind-Value="formModel.ToEmail" TextFieldType="TextFieldType.Email" Style="flex:1;" />
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                        <FluentLabel Typo="Typography.Body" Style="min-width:160px; color: var(--neutral-foreground-hint);">CC Email (optional)</FluentLabel>
                        <FluentTextField @bind-Value="formModel.CcEmail" TextFieldType="TextFieldType.Email" Style="flex:1;" />
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
                        <FluentLabel Typo="Typography.Body" Style="min-width:160px; color: var(--neutral-foreground-hint);">Subject</FluentLabel>
                        <FluentTextField @bind-Value="formModel.Subject" Style="flex:1;" />
                    </FluentStack>
                </FluentStack>
            </EditForm>
        </FluentCard>

        <FluentCard Style="padding:16px; min-height:0; overflow:auto;">
            <FluentLabel Typo="Typography.Subject">Preview</FluentLabel>
            <div style="border:1px solid #e5e7eb; border-radius:12px; padding:16px; background:#fff;">
                @((MarkupString)formModel.HtmlBody)
            </div>
        </FluentCard>
    </div>
</FluentLayout>

@code {
    private const string ApiBaseUrl = "https://localhost:60241/";

    [Parameter]
    public int OrderId { get; set; }

    private GetOrderByIdResponse? order;
    private CustomerDto? customer;
    private SendInvoiceEmailRequest formModel = new();
    private DateTime dueDate = DateTime.Today.AddDays(14);
    private bool isSending;
    private string? message;
    private MessageIntent messageIntent = MessageIntent.Info;

    private bool CanSend => order is not null && customer is not null && !isSending;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User?.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            order = await Http.GetFromJsonAsync<GetOrderByIdResponse>($"{ApiBaseUrl}orders/{OrderId}");
            if (order is null)
            {
                message = "Order not found.";
                messageIntent = MessageIntent.Error;
                return;
            }

            customer = await Http.GetFromJsonAsync<CustomerDto>($"{ApiBaseUrl}customers/{order.CustomerId}");
            if (customer is null)
            {
                message = "Customer not found.";
                messageIntent = MessageIntent.Error;
                return;
            }

            dueDate = order.OrderDate.Date.AddDays(14);
            RegenerateTemplate();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load invoice email data for order {OrderId}", OrderId);
            message = "Failed to load invoice email page.";
            messageIntent = MessageIntent.Error;
        }
    }

    private void RegenerateTemplate()
    {
        if (order is null || customer is null)
        {
            return;
        }

        var template = InvoiceEmailTemplateBuilder.Build(order, customer, dueDate);
        formModel.ToEmail = string.IsNullOrWhiteSpace(formModel.ToEmail) ? (customer.Email ?? string.Empty) : formModel.ToEmail;
        formModel.Subject = template.Subject;
        formModel.HtmlBody = template.HtmlBody;
        message = null;
    }

    private async Task SendEmailAsync()
    {
        if (!CanSend)
        {
            return;
        }

        isSending = true;
        message = null;

        try
        {
            // Attach PDF invoice - fetch from API
            byte[]? pdfBytes = null;
            try
            {
                pdfBytes = await Http.GetByteArrayAsync($"{ApiBaseUrl}orders/{OrderId}/invoice/pdf");
            }
            catch
            {
                // ignore failure to attach pdf
            }

            var request = new
            {
                ToEmail = formModel.ToEmail,
                CcEmail = formModel.CcEmail,
                Subject = formModel.Subject,
                HtmlBody = formModel.HtmlBody,
                AttachmentFileName = pdfBytes is null ? null : $"invoice-{OrderId}.pdf",
                AttachmentContent = pdfBytes is null ? null : Convert.ToBase64String(pdfBytes),
                AttachmentContentType = pdfBytes is null ? null : "application/pdf"
            };

            var response = await Http.PostAsJsonAsync($"{ApiBaseUrl}orders/{OrderId}/email", request);
            if (response.IsSuccessStatusCode)
            {
                message = "Email berhasil dikirim.";
                messageIntent = MessageIntent.Success;
                return;
            }

            var error = await response.Content.ReadAsStringAsync();
            message = $"Gagal mengirim email. {error}";
            messageIntent = MessageIntent.Error;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to send invoice email for order {OrderId}", OrderId);
            message = "Unexpected error while sending email.";
            messageIntent = MessageIntent.Error;
        }
        finally
        {
            isSending = false;
        }
    }

    private void Back() => Navigation.NavigateTo("/orders");
}
