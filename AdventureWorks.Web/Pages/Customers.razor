@page "/customers"

@using AdventureWorks.Web.Models
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<Customers> Logger
@inject HttpClient Http
@inject IJSRuntime JS

<FluentLayout Style="height: 100%; display: flex; flex-direction: column;">

    <FluentToolbar class="toolbar-fixed">
        <h3>Customers</h3>
        <FluentButton Appearance="Appearance.Accent"
                      IconStart="@(new Icons.Regular.Size16.Add())"
                      @onclick="BeginCreate">
            Add
        </FluentButton>
        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-left: auto;">
            <FluentSearch Placeholder="Search by customer name..."
                          @bind-Value="searchTerm"
                          @bind-Value:after="RefreshAsync"
                          Style="width: 280px;" />
        </div>
    </FluentToolbar>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <FluentMessageBar Intent="@messageIntent" Style="margin-bottom: 8px;">
            @message
        </FluentMessageBar>
    }

    @if (isEditorOpen)
    {
        <FluentCard Style="padding: 16px; margin-bottom: 8px;">
            <h4 style="margin-top:0;">@(isEditMode ? "Update Customer" : "Create Customer")</h4>
            <EditForm Model="formModel" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <FluentValidationSummary />

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                    <FluentTextField @bind-Value="formModel.CustomerName" Label="Customer name" Style="width:100%" />
                    <FluentTextField @bind-Value="formModel.ContactName" Label="Contact name" Style="width:100%" />
                    <FluentTextField @bind-Value="formModel.PhoneNumber" Label="Phone number" Style="width:100%" />
                    <FluentTextField @bind-Value="formModel.Email" Label="Email" TextFieldType="TextFieldType.Email" Style="width:100%" />
                    <FluentTextArea @bind-Value="formModel.Address" Label="Address" Rows="3" Style="width:100%" />
                </FluentStack>

                <div style="display:flex; gap:8px; margin-top: 16px;">
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="isSaving">
                        @(isEditMode ? "Update" : "Create")
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Neutral" @onclick="CancelEdit" Disabled="isSaving">
                        Cancel
                    </FluentButton>
                </div>
            </EditForm>
        </FluentCard>
    }

    <div id="customersGrid" class="grid-wrapper grid-sticky-header" style="height: calc(100vh - 200px); overflow-y: auto;">
        <FluentDataGrid @ref="grid"
                        ItemsProvider="@(new GridItemsProvider<CustomerDto>(LoadCustomers))"
                        Pagination="@pagination"
                        TItem="CustomerDto"
                        ResizableColumns="true"
                        Style="width: 100%;">
            <PropertyColumn Property="@(c => c.CustomerId)" Title="ID" />
            <PropertyColumn Property="@(c => c.CustomerName)" Title="Customer" />
            <PropertyColumn Property="@(c => c.ContactName)" Title="Contact" />
            <PropertyColumn Property="@(c => c.PhoneNumber)" Title="Phone" />
            <PropertyColumn Property="@(c => c.Email)" Title="Email" />
            <TemplateColumn Title="Address">
                <span>@(string.IsNullOrWhiteSpace(context.Address) ? "-" : context.Address)</span>
            </TemplateColumn>
            <TemplateColumn Title="Actions" Align="Align.End">
                <div style="display:flex; gap:6px; justify-content:flex-end;">
                    <FluentButton Appearance="Appearance.Neutral" @onclick="() => BeginEdit(context)">
                        Edit
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Stealth" @onclick="() => DeleteAsync(context.CustomerId, context.CustomerName)">
                        Delete
                    </FluentButton>
                </div>
            </TemplateColumn>
        </FluentDataGrid>
    </div>

    <div class="pagination pagination-fixed">
        <FluentPaginator State="@pagination" />
    </div>

</FluentLayout>

@code {
    private const string ApiBaseUrl = "https://localhost:60241/";

    private FluentDataGrid<CustomerDto> grid = default!;
    private PaginationState pagination = new() { ItemsPerPage = 25 };
    private string searchTerm = string.Empty;

    private CustomerFormModel formModel = new();
    private bool isEditorOpen;
    private bool isSaving;
    private bool isEditMode => formModel.CustomerId.HasValue;

    private string? message;
    private MessageIntent messageIntent = MessageIntent.Info;

    private async ValueTask<GridItemsProviderResult<CustomerDto>> LoadCustomers(GridItemsProviderRequest<CustomerDto> req)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User?.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login", true);
                return GridItemsProviderResult.From(new List<CustomerDto>(), 0);
            }

            var pageSize = pagination.ItemsPerPage == 0 ? 25 : pagination.ItemsPerPage;
            var currentPage = (req.StartIndex / pageSize) + 1;

            var url = $"{ApiBaseUrl}customers?page={currentPage}&pageSize={pageSize}";
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                url += $"&searchTerm={Uri.EscapeDataString(searchTerm)}";
            }

            var response = await Http.GetFromJsonAsync<PagedResponse<CustomerDto>>(url, req.CancellationToken);
            if (response is null)
            {
                return GridItemsProviderResult.From(new List<CustomerDto>(), 0);
            }

            return GridItemsProviderResult.From(response.Items, response.TotalCount);
        }
        catch (OperationCanceledException)
        {
            return GridItemsProviderResult.From(new List<CustomerDto>(), 0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to fetch customers from {Url}", $"{ApiBaseUrl}customers");
            ShowMessage("Failed to load customer data.", MessageIntent.Error);
            return GridItemsProviderResult.From(new List<CustomerDto>(), 0);
        }
    }

    private void BeginCreate()
    {
        formModel = new CustomerFormModel();
        isEditorOpen = true;
        message = null;
    }

    private void BeginEdit(CustomerDto customer)
    {
        formModel = new CustomerFormModel
        {
            CustomerId = customer.CustomerId,
            CustomerName = customer.CustomerName,
            ContactName = customer.ContactName,
            PhoneNumber = customer.PhoneNumber,
            Email = customer.Email,
            Address = customer.Address
        };

        isEditorOpen = true;
        message = null;
    }

    private void CancelEdit()
    {
        isEditorOpen = false;
    }

    private async Task SaveAsync()
    {
        isSaving = true;

        try
        {
            var request = new CustomerUpsertRequest
            {
                CustomerName = formModel.CustomerName,
                ContactName = formModel.ContactName,
                PhoneNumber = formModel.PhoneNumber,
                Email = formModel.Email,
                Address = formModel.Address
            };

            HttpResponseMessage response;
            if (isEditMode)
            {
                response = await Http.PutAsJsonAsync($"{ApiBaseUrl}customers/{formModel.CustomerId}", request);
            }
            else
            {
                response = await Http.PostAsJsonAsync($"{ApiBaseUrl}customers", request);
            }

            if (response.IsSuccessStatusCode)
            {
                isEditorOpen = false;
                ShowMessage(isEditMode ? "Customer updated successfully." : "Customer created successfully.", MessageIntent.Success);
                await RefreshAsync();
                return;
            }

            var error = await response.Content.ReadAsStringAsync();
            ShowMessage($"Failed to save customer. {error}", MessageIntent.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save customer");
            ShowMessage("Unexpected error while saving customer.", MessageIntent.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteAsync(int customerId, string customerName)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", $"Delete customer '{customerName}'?");
        if (!confirm)
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"{ApiBaseUrl}customers/{customerId}");
            if (response.IsSuccessStatusCode)
            {
                if (formModel.CustomerId == customerId)
                {
                    isEditorOpen = false;
                }

                ShowMessage("Customer deleted successfully.", MessageIntent.Success);
                await RefreshAsync();
                return;
            }

            var error = await response.Content.ReadAsStringAsync();
            ShowMessage($"Failed to delete customer. {error}", MessageIntent.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete customer {CustomerId}", customerId);
            ShowMessage("Unexpected error while deleting customer.", MessageIntent.Error);
        }
    }

    private async Task RefreshAsync()
    {
        await grid.RefreshDataAsync();
    }

    private void ShowMessage(string text, MessageIntent intent)
    {
        message = text;
        messageIntent = intent;
    }
}
